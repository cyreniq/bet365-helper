{
  "manifest_version": 3,
  "name": "bet365 Helper",
  "version": "1.0.0",
  "description": "Live match alerts for bet365. Click the icon on a match tab to start or stop monitoring it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16_disabled.png",
      "32": "icons/icon32_disabled.png",
      "48": "icons/icon48_disabled.png",
      "128": "icons/icon128_disabled.png"
    },
    "default_title": "bet365 Helper: click to start/stop monitoring this tab"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "storage", "offscreen"],
  "host_permissions": [
    "*://*.bet365.com/*",
    "*://*.bet365.ee/*",
    "*://*.bet365.es/*",
    "*://*.bet365.it/*",
    "*://*.bet365.gr/*",
    "*://*.bet365.dk/*",
    "*://*.bet365.de/*",
    "*://*.bet365.mx/*",
    "*://*.bet365.ca/*",
    "*://*.bet365.com.au/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.bet365.com/*",
        "*://*.bet365.ee/*",
        "*://*.bet365.es/*",
        "*://*.bet365.it/*",
        "*://*.bet365.gr/*",
        "*://*.bet365.dk/*",
        "*://*.bet365.de/*",
        "*://*.bet365.mx/*",
        "*://*.bet365.ca/*",
        "*://*.bet365.com.au/*"
      ],
      "js": ["content/raf-shim.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*.wav"],
      "matches": [
        "*://*.bet365.com/*",
        "*://*.bet365.ee/*",
        "*://*.bet365.es/*",
        "*://*.bet365.it/*",
        "*://*.bet365.gr/*",
        "*://*.bet365.dk/*",
        "*://*.bet365.de/*",
        "*://*.bet365.mx/*",
        "*://*.bet365.ca/*",
        "*://*.bet365.com.au/*"
      ]
    }
  ]
}
